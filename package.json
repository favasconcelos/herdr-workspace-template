{
  "name": "herdr-workspace-template",
  "version": "0.1.0",
  "description": "Herdr plugin: auto-create pre-configured tabs on every new workspace",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "rm -rf dist dist-test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@favasconcelos/biome-config": "2.0.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
